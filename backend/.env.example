# Get a free API key: https://www.themoviedb.org → Settings → API → "API Key (v3 auth)"
# Copy this file to .env and paste your key to switch from sample data to live daily releases.
TMDB_API_KEY=

# Optional: Google OAuth client id (Google Cloud Console -> Credentials).
# When set, publishing a blog post requires Google sign-in; leave empty to allow
# anonymous posting (reading the blog never needs an account).
GOOGLE_CLIENT_ID=

# Private stats dashboard (/stats): the Google account(s) allowed to read click
# stats, comma-separated. Unset means nobody can — the dashboard fails closed.
# In production this is a Worker secret: wrangler secret put OWNER_EMAIL
OWNER_EMAIL=
