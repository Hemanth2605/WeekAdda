# Optional: same Google OAuth client id as the backend (see backend/.env.example).
# Baked in at build time; when empty, the blog composer never asks for sign-in.
VITE_GOOGLE_CLIENT_ID=

# Optional: the VAPID *public* key from backend/.env (public by design — it is
# baked into the bundle). Without it the "Notify me" button never renders.
VITE_VAPID_PUBLIC_KEY=
